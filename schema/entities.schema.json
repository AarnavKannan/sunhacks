{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reconstruct.local/schema/entities.schema.json",
  "title": "SceneEntities",
  "type": "object",
  "additionalProperties": false,
  "required": ["entities"],
  "properties": {
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" }
    }
  },
  "$defs": {
    "dims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length", "width", "height"],
      "description": "Proxy-mesh size in meters. Length is local +X, height is local +Y, width is local +Z.",
      "properties": {
        "length": { "type": "number", "exclusiveMinimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "color",
        "color_hex",
        "type",
        "make",
        "model",
        "dims_m",
        "aliases",
        "confidence",
        "label_source",
        "carriageway",
        "splat"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "color": {
          "type": "string",
          "description": "Paint color. Class overlay color is the manifest legend."
        },
        "color_hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "type": { "enum": ["car", "van", "truck"] },
        "make": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "dims_m": { "$ref": "#/$defs/dims" },
        "aliases": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "label_source": { "enum": ["vlm", "manual", "measured"] },
        "carriageway": { "enum": ["a", "b"] },
        "splat": {
          "type": "string",
          "description": "Path relative to the package root. A shared class file is allowed."
        }
      }
    }
  }
}
