{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reconstruct.local/schema/manifest.schema.json",
  "title": "ScenePackageManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "description",
    "fps",
    "duration_s",
    "frame_count",
    "impact_time_s",
    "units",
    "up_axis",
    "crs",
    "origin",
    "source",
    "mosaic",
    "road",
    "tracks_are_schematic",
    "splat_format",
    "models",
    "seeds",
    "class_legend",
    "pipeline"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "1.0.0" },
    "description": { "type": "string" },
    "fps": { "type": "number", "exclusiveMinimum": 0 },
    "duration_s": { "type": "number", "exclusiveMinimum": 0 },
    "frame_count": { "type": "integer", "minimum": 1 },
    "impact_time_s": {
      "type": ["number", "null"],
      "description": "Seconds from the first frame. Null when the clip has no impact. Do not treat 0 as impact."
    },
    "units": { "$ref": "#/$defs/units" },
    "up_axis": { "const": "Y" },
    "crs": {
      "const": "local",
      "description": "Local scene frame, not a geodetic CRS."
    },
    "origin": { "$ref": "#/$defs/origin" },
    "source": { "$ref": "#/$defs/source" },
    "mosaic": { "$ref": "#/$defs/mosaic" },
    "road": { "$ref": "#/$defs/road" },
    "tracks_are_schematic": {
      "type": "boolean",
      "description": "True when speeds were authored and smoothed, not measured from video."
    },
    "splat_format": { "enum": ["ply", "spz"] },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/model" }
    },
    "seeds": { "$ref": "#/$defs/seeds" },
    "class_legend": { "$ref": "#/$defs/classLegend" },
    "pipeline": { "$ref": "#/$defs/pipeline" }
  },
  "$defs": {
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length", "time"],
      "properties": {
        "length": { "const": "m" },
        "time": { "const": "s" }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["landmark", "description"],
      "properties": {
        "landmark": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "sha256",
        "codec",
        "width",
        "height",
        "fps",
        "duration_s",
        "frame_count",
        "has_audio"
      ],
      "properties": {
        "filename": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "codec": { "type": "string" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "duration_s": { "type": "number", "exclusiveMinimum": 0 },
        "frame_count": { "type": "integer", "minimum": 1 },
        "has_audio": { "type": "boolean" }
      }
    },
    "span": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer" },
      "description": "Inclusive pixel span. Image y grows downward."
    },
    "mosaic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "image_origin",
        "column_gutter_x",
        "row_gutter_y",
        "letterbox_y"
      ],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "image_origin": { "const": "top-left" },
        "column_gutter_x": { "$ref": "#/$defs/span" },
        "row_gutter_y": { "$ref": "#/$defs/span" },
        "letterbox_y": { "$ref": "#/$defs/span" }
      }
    },
    "carriageway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "z_sign", "cameras"],
      "properties": {
        "heading": { "enum": ["+X", "-X"] },
        "z_sign": { "enum": [-1, 1] },
        "cameras": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "road": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stretch_m",
        "x_min_m",
        "x_max_m",
        "lane_width_m",
        "lanes_per_carriageway",
        "shoulder",
        "median_half_width_m",
        "carriageways"
      ],
      "properties": {
        "stretch_m": { "type": "number", "exclusiveMinimum": 0 },
        "x_min_m": { "type": "number" },
        "x_max_m": { "type": "number" },
        "lane_width_m": { "type": "number", "exclusiveMinimum": 0 },
        "lanes_per_carriageway": { "type": "integer", "minimum": 1 },
        "shoulder": { "type": "boolean" },
        "median_half_width_m": { "type": "number", "exclusiveMinimum": 0 },
        "carriageways": {
          "type": "object",
          "additionalProperties": false,
          "required": ["a", "b"],
          "properties": {
            "a": { "$ref": "#/$defs/carriageway" },
            "b": { "$ref": "#/$defs/carriageway" }
          }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "name", "version", "seed"],
      "properties": {
        "role": { "type": "string" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "seed": { "type": "integer" }
      }
    },
    "seeds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schematic", "kinematics"],
      "properties": {
        "schematic": { "type": "integer" },
        "kinematics": { "type": "integer" }
      }
    },
    "classColor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "hex"],
      "properties": {
        "name": { "type": "string" },
        "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      }
    },
    "classLegend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["car", "van", "truck"],
      "description": "Burned-in box colors. Paint color lives on each entity.",
      "properties": {
        "car": { "$ref": "#/$defs/classColor" },
        "van": { "$ref": "#/$defs/classColor" },
        "truck": { "$ref": "#/$defs/classColor" }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "command", "config"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "command": { "type": "string" },
        "config": { "type": "string" }
      }
    }
  }
}
