{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reconstruct.local/schema/events.schema.json",
  "title": "SceneEvents",
  "type": "object",
  "additionalProperties": false,
  "required": ["events"],
  "properties": {
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "t", "type", "vehicles", "note"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "t": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds from the first frame."
        },
        "type": {
          "enum": ["impact", "brake", "rest", "lane_change", "pass"],
          "description": "impact, brake, and rest stay legal when a later clip has them."
        },
        "vehicles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "For a pass, the first id is the vehicle that overtakes."
        },
        "note": { "type": "string" }
      }
    }
  }
}
