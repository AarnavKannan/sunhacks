{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reconstruct.local/schema/cameras.schema.json",
  "title": "SceneCameras",
  "type": "object",
  "additionalProperties": false,
  "required": ["cameras"],
  "properties": {
    "cameras": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/camera" }
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "quat": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number" },
      "description": "Quaternion [x, y, z, w]."
    },
    "crop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "description": "Pixel rectangle in the mosaic. Image y grows downward from the top left.",
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "exclusiveMinimum": 0 },
        "height": { "type": "integer", "exclusiveMinimum": 0 }
      }
    },
    "intrinsics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "width", "height", "fx", "fy", "cx", "cy"],
      "properties": {
        "model": { "const": "pinhole" },
        "width": { "type": "integer", "exclusiveMinimum": 0 },
        "height": { "type": "integer", "exclusiveMinimum": 0 },
        "fx": { "type": "number", "exclusiveMinimum": 0 },
        "fy": { "type": "number", "exclusiveMinimum": 0 },
        "cx": { "type": "number" },
        "cy": { "type": "number" }
      }
    },
    "extrinsics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["convention", "position_m", "quaternion"],
      "properties": {
        "convention": { "const": "camera_to_world_opengl" },
        "position_m": { "$ref": "#/$defs/vec3" },
        "quaternion": { "$ref": "#/$defs/quat" }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "static", "mosaic_crop", "intrinsics", "extrinsics", "note"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "static": { "type": "boolean" },
        "mosaic_crop": { "$ref": "#/$defs/crop" },
        "intrinsics": { "$ref": "#/$defs/intrinsics" },
        "extrinsics": { "$ref": "#/$defs/extrinsics" },
        "note": { "type": "string" }
      }
    }
  }
}
