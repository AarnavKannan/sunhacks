{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reconstruct.local/schema/tracks.schema.json",
  "title": "SceneTracks",
  "type": "object",
  "additionalProperties": false,
  "required": ["tracks"],
  "properties": {
    "tracks": {
      "type": "array",
      "items": { "$ref": "#/$defs/track" }
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "quat": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number" },
      "description": "Quaternion [x, y, z, w]."
    },
    "sigma": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pos_m", "speed_mps"],
      "description": "Fixed MVP uncertainty. Not a fitted covariance.",
      "properties": {
        "pos_m": { "type": "number", "minimum": 0 },
        "speed_mps": { "type": "number", "minimum": 0 }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "t",
        "pos",
        "quat",
        "vel",
        "acc",
        "speed_mps",
        "heading_deg",
        "yaw_rate",
        "sigma"
      ],
      "properties": {
        "t": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds from the first frame of the mosaic."
        },
        "pos": {
          "$ref": "#/$defs/vec3",
          "description": "Vehicle center in meters. Y is up."
        },
        "quat": { "$ref": "#/$defs/quat" },
        "vel": {
          "$ref": "#/$defs/vec3",
          "description": "World-frame velocity, meters per second."
        },
        "acc": {
          "$ref": "#/$defs/vec3",
          "description": "World-frame acceleration, meters per second squared."
        },
        "speed_mps": { "type": "number", "minimum": 0 },
        "heading_deg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180,
          "description": "0 faces +X. 180 faces −X. Positive heading turns toward −Z."
        },
        "yaw_rate": {
          "type": "number",
          "description": "Radians per second about +Y."
        },
        "sigma": { "$ref": "#/$defs/sigma" }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "carriageway", "visibility", "samples"],
      "properties": {
        "entity_id": { "type": "string", "minLength": 1 },
        "carriageway": { "enum": ["a", "b"] },
        "visibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["t_start", "t_end"],
          "description": "Samples exist only while the vehicle is inside the reconstructed stretch.",
          "properties": {
            "t_start": { "type": "number", "minimum": 0 },
            "t_end": { "type": "number", "minimum": 0 }
          }
        },
        "samples": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/sample" }
        }
      }
    }
  }
}
